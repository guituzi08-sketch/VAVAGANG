rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canAccessRoom(roomId) {
      return signedIn()
        && (get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid
          || exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.blockedUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.recipientId != null;
    }

    match /groupInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.recipientId != request.auth.uid;
      allow update: if signedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /directMessages/{messageId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.blockedUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.recipientId != null;
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }

    match /groupInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.recipientId != request.auth.uid;
      allow update: if signedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /groups/{groupId} {
      function roleAtLeast(role) {
        return resource.data.roles[request.auth.uid] == role
          || (role == 'MODERATOR' && resource.data.roles[request.auth.uid] == 'ADMIN')
          || (role == 'MODERATOR' && resource.data.roles[request.auth.uid] == 'OWNER')
          || (role == 'ADMIN' && resource.data.roles[request.auth.uid] == 'OWNER');
      }
      allow read: if signedIn()
        && (resource.data.privacy != 'private' || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || roleAtLeast('ADMIN'))
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /channels/{channelId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.privacy != 'private'
            || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds);
        allow create, update, delete: if signedIn()
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.roles[request.auth.uid] == 'ADMIN');

        match /messages/{messageId} {
          allow read: if signedIn()
            && (get(/databases/$(database)/documents/groups/$(groupId)).data.privacy != 'private'
              || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds);
          allow create: if signedIn()
            && request.resource.data.authorId == request.auth.uid
            && (get(/databases/$(database)/documents/groups/$(groupId)).data.privacy != 'private'
              || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds);
          allow update, delete: if signedIn()
            && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
              || get(/databases/$(database)/documents/groups/$(groupId)).data.roles[request.auth.uid] in ['ADMIN', 'MODERATOR']);
        }
      }
    }

    match /vavagramPosts/{postId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /vavagramStories/{storyId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /vavaxPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /vavaxLikes/{likeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /vavaxComments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    match /vavaxFollows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /vavaxNotifications/{notificationId} {
      allow read, update, delete: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
    }

    match /soundEffects/{effectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'storagePath', 'publicUrl', 'mimeType', 'size', 'createdBy', 'createdAt'])
        && request.resource.data.size <= 10485760;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    match /{path=**}/soundEffects/{effectId} {
      allow read: if signedIn();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
            && request.resource.data.participantCount >= 0)
          || ((resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'status', 'closedAt']))
        );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.createdBy == request.auth.uid);

      match /participants/{participantId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && participantId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'closed';
        allow delete: if signedIn() && (participantId == request.auth.uid || resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }

      match /signals/{signalId} {
        allow read: if signedIn() && resource.data.to == request.auth.uid;
        allow create, update: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to != request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'closed';
        allow delete: if signedIn() && (resource.data.from == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }

      match /candidates/{candidateId} {
        allow read: if signedIn() && resource.data.to == request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to != request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'closed';
        allow delete: if signedIn() && (resource.data.from == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
      }

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'closed';
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.createdBy == request.auth.uid);
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status != 'closed';
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid);
        allow update: if false;
      }

      match /soundEffects/{effectId} {
        allow read: if canAccessRoom(roomId);
        allow create: if canAccessRoom(roomId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasAll(['name', 'storagePath', 'publicUrl', 'mimeType', 'size', 'createdBy', 'createdAt'])
          && request.resource.data.size <= 10485760;
        allow delete: if canAccessRoom(roomId)
          && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid);
        allow update: if false;
      }

      match /soundEffectEvents/{eventId} {
        allow read: if canAccessRoom(roomId);
        allow create: if canAccessRoom(roomId)
          && request.resource.data.triggeredBy == request.auth.uid
          && request.resource.data.keys().hasAll(['effectId', 'triggeredBy', 'triggeredAt']);
        allow update, delete: if false;
      }
    }
  }
}